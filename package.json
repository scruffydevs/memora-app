{
  "name": "memora-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "build": "npm --prefix web install && npm --prefix web run build",
    "dev": "node --watch src/index.js",
    "migrate": "node src/migrate.js",
    "seed": "node scripts/seed.js",
    "leaktest": "node scripts/leaktest.js",
    "test": "node --test test/e2e.test.js test/memory.test.js test/health.test.js test/onboarding.test.js",
    "set-password": "node scripts/set-password.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17"
  }
}
